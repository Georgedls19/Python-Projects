from random import choice

plays =["Piedra","Papel","Tijeras"]

def get_verb(winner,loser):
    verbs = {
        "Piedra": {"Tijeras":"Piedra destruye Tijeras"},
        "Papel": {"Piedra":"Papel cubre a la Piedra"},
        "Tijeras": {"Papel":"Tijeras corta al papel"}            
    }
    return verbs[winner][loser]

while True:
    computer = choice(plays)
    
    player = input("Piedra, papel o tijeras? (Escribir exit para salir): ").capitalize()
    if player == "exit":
        print("Adiós!")
        break
    
    if player not in plays:
        print("No es un juego válido")
        continue
    
    if player == computer:
        print("Es un juego de empates")
    elif (player == "Piedra" and computer == "Tijeras") \
        or (player == "Papel" and computer == "Piedra") \
        or (player == "Tijeras" and computer == "Papel"):
            print("El ganador es el " + player)
            print(get_verb(player,computer))
    else:
        print("El ganador es el " + computer)
        print(get_verb(computer,player))    

    play_again = input("¿Quieres jugar otra vez? (S/N): ").lower()
    if play_again != "s":
        print("Gracias por jugar!")
        break
